---
import LightingIllustration from '../ui/LightingIllustration.astro';
import { LIGHTING } from '../../content.config';
import { LIGHTING_LABELS } from '../../lib/content';

interface Props {
  /** Limit to these styles (type pages). Default: all five. */
  only?: readonly (typeof LIGHTING)[number][];
  dark?: boolean;
}
const { only = LIGHTING, dark = true } = Astro.props;

const TEXT: Record<string, string> = {
  none: 'No lights. The letters or board are read by daylight or street light.',
  'front-lit': 'LEDs inside each letter shine forward through a translucent face.',
  backlit: 'Lights sit behind a translucent panel, so the whole face glows.',
  'halo-lit': 'Solid letters stand off the wall and light spills out behind them.',
  neon: 'A glowing line of LED neon flex traces the letters or logo.',
};
---

<ul class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-5">
  {
    only.map((kind) => (
      <li class:list={['rounded-xl p-3', dark ? 'bg-ink-soft' : 'border border-line bg-paper-soft']}>
        <LightingIllustration kind={kind} class="w-full rounded-lg" />
        <h3 class="mt-3 font-bold">{LIGHTING_LABELS[kind]}</h3>
        <p class:list={['mt-1 text-sm leading-relaxed', dark ? 'text-muted-dark' : 'text-muted']}>{TEXT[kind]}</p>
      </li>
    ))
  }
</ul>
