---
import ProjectCard from '../ui/ProjectCard.astro';
import type { Project } from '../../lib/content';

interface Props {
  projects: Project[];
  headingLevel?: 'h2' | 'h3';
  dark?: boolean;
}
const { projects, headingLevel = 'h3', dark = false } = Astro.props;
---

<ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
  {projects.map((project) => <li><ProjectCard {project} {headingLevel} {dark} /></li>)}
</ul>
