---
import { Picture } from 'astro:assets';
import Button from '../ui/Button.astro';
import WhatsAppButton from '../ui/WhatsAppButton.astro';
import logoSign from '../../assets/brand/logo-sign-wide.webp';
import { isPlaceholder, site } from '../../config/site';

interface Props {
  waMessage: string;
}
const { waMessage } = Astro.props;
---

<section class="bg-ink text-white">
  <div class="wrap grid items-center gap-8 py-10 md:py-16 lg:grid-cols-[1.05fr_1fr]">
    <div>
      {
        !isPlaceholder(site.nameUrdu) && (
          <p lang="ur" dir="rtl" class="text-start text-2xl text-brand">
            {site.nameUrdu}
          </p>
        )
      }
      <p class="eyebrow text-brand">Signboard workshop · {site.address.city}</p>
      <h1 class="mt-3 text-4xl leading-[1.05] font-black tracking-tight md:text-6xl">
        Signboards, LED <span class="text-brand">&amp;</span> Neon Signs in {site.address.city}
      </h1>
      <p class="mt-4 max-w-xl text-lg text-white/85">
        Custom 2D and 3D signboards, LED-lit letters, neon signs and nameplates for shops, offices and homes.
        {site.nationwide && ' Orders taken from all over Pakistan.'}
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <WhatsAppButton message={waMessage} location="hero" />
        <Button href="/design-your-sign/" variant="outline-dark" size="lg">Design Your Sign</Button>
      </div>
    </div>
    <Picture
      src={logoSign}
      alt={`The ${site.name} logo as an illuminated 3D sign on a dark wall`}
      formats={['avif', 'webp']}
      widths={[360, 560, 760, 1134]}
      sizes="(min-width: 1024px) 46vw, 100vw"
      loading="eager"
      fetchpriority="high"
      class="w-full rounded-2xl"
    />
  </div>
</section>
