---
import type { Crumb } from '../../lib/schema';

interface Props {
  items: Crumb[];
  dark?: boolean;
}
const { items, dark = false } = Astro.props;
---

<nav aria-label="Breadcrumb" class:list={['text-sm', dark ? 'text-muted-dark' : 'text-muted']}>
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && <span aria-hidden="true">/</span>}
          {i === items.length - 1 ? (
            <span aria-current="page" class={dark ? 'text-white' : 'text-ink'}>
              {item.name}
            </span>
          ) : (
            <a href={item.href} class="underline-offset-2 hover:underline">
              {item.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
