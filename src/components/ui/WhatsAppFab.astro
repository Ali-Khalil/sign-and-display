---
import Icon from './Icon.astro';
import { waLink } from '../../lib/whatsapp';

interface Props {
  message: string;
  type?: string;
}
const { message, type = '' } = Astro.props;
---

<a
  href={waLink(message)}
  target="_blank"
  rel="noopener"
  data-wa-location="floating-button"
  data-wa-type={type}
  aria-label="Chat on WhatsApp"
  class="fixed end-4 bottom-4 z-40 flex size-14 items-center justify-center rounded-full bg-whatsapp text-whatsapp-ink shadow-lg shadow-black/30 transition-transform hover:scale-105"
>
  <Icon name="whatsapp" class="size-8" />
</a>
