---
import Button from './Button.astro';
import WhatsAppButton from './WhatsAppButton.astro';

interface Props {
  heading?: string;
  text?: string;
  message: string;
  type?: string;
  /** Hide the "Design Your Sign" button. */
  noDesign?: boolean;
  designHref?: string;
}

const {
  heading = 'Ready to get your sign made?',
  text = 'Send the name, approximate size and your city. You get a design and a quote on WhatsApp.',
  message,
  type,
  noDesign = false,
  designHref = '/design-your-sign/',
} = Astro.props;
---

<section class="bg-hero text-white">
  <div class="wrap section flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
    <div class="max-w-xl">
      <h2 class="h2">{heading}</h2>
      <p class="mt-3 text-white/85">{text}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <WhatsAppButton message={message} location="cta-band" type={type} />
      {!noDesign && <Button href={designHref} variant="outline-dark" size="lg">Design Your Sign</Button>}
    </div>
  </div>
</section>
