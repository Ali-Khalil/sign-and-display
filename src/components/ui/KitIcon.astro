---
/** Simple line icon for a welcome-kit item, picked from the item's name. */
interface Props {
  name: string;
  class?: string;
}
const { name, class: className = 'size-10' } = Astro.props;
const n = name.toLowerCase();

const PATHS: Record<string, string> = {
  box: '<path d="M3 8.5 12 4l9 4.5v8L12 21l-9-4.5Z"/><path d="m3 8.5 9 4.5 9-4.5M12 13v8"/><path d="m7.5 6.2 9 4.6"/>',
  mug: '<path d="M5 6h11v9a4 4 0 0 1-4 4H9a4 4 0 0 1-4-4Z"/><path d="M16 9h1.5a2.5 2.5 0 0 1 0 5H16"/><path d="M8 3v1.5M11 3v1.5"/>',
  bottle: '<path d="M10 2.5h4v3l1.5 2.5V20a1.5 1.5 0 0 1-1.5 1.5h-4A1.5 1.5 0 0 1 8.5 20V8L10 5.5Z"/><path d="M8.5 11h7M8.5 17h7"/>',
  notepad: '<rect x="5" y="4" width="14" height="17" rx="1.5"/><path d="M8 2.5v3M12 2.5v3M16 2.5v3M8.5 10h7M8.5 13.5h7M8.5 17h4.5"/>',
  pencil: '<path d="m4 20 1.2-4.8L15.6 4.8a2 2 0 0 1 2.8 0l.8.8a2 2 0 0 1 0 2.8L8.8 18.8Z"/><path d="m13.8 6.6 3.6 3.6M4 20l4.8-1.2"/>',
  more: '<circle cx="12" cy="12" r="8.5"/><path d="M12 8v8M8 12h8"/>',
};
const key = n.includes('box')
  ? 'box'
  : /mug|cup/.test(n)
    ? 'mug'
    : n.includes('bottle')
      ? 'bottle'
      : /note|diary|book/.test(n)
        ? 'notepad'
        : /pencil|pen\b|pens/.test(n)
          ? 'pencil'
          : 'more';
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={PATHS[key]}
/>
