---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<!-- Internal Phase 0 test page: noindex, excluded from the sitemap. -->
<BaseLayout title="Urdu / RTL Fabric.js spike" noindex>
  <div class="mx-auto max-w-[2040px] px-4 py-8">
    <h1 class="text-2xl font-bold">Urdu / RTL rendering spike</h1>
    <p class="text-muted">
      Columns in each canvas: flat · 3D extrude · front-lit · halo-lit · neon. Green dashes = the
      object's bounding box.
    </p>
    <p id="spike-status" class="my-2 text-brand">Running…</p>
    <div id="spike-root"></div>
    <h2 class="mt-10 text-xl font-bold">Selection handles (left: Fabric native, right: ShapedText)</h2>
    <div id="handles-wrap" class="inline-block"><canvas id="handles"></canvas></div>
    <h2 class="mt-10 text-xl font-bold">Measurements</h2>
    <pre id="spike-json" class="overflow-x-auto text-xs text-muted"></pre>
  </div>
</BaseLayout>

<style is:global>
  .spike-font { margin-block: 2.5rem; }
  .spike-font h2 { font-size: 1.5rem; font-weight: 700; color: var(--color-brand); }
  .spike-font h3 { margin-block: 1rem 0.5rem; font-weight: 600; }
  .spike-font .ref { display: inline-block; background: #14161b; padding: 0.5rem 1.5rem; min-width: 400px; }
  .spike-font .ref p { text-align: center; margin: 0; line-height: 130px; height: 130px; white-space: nowrap; }
  .spike-font .scroll { overflow-x: auto; }
</style>

<script>
  import '../../spike/rtl-spike';
</script>
