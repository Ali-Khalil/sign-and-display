---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---

<!-- Phase 0 holding page. Replaced by the real home page in Phase 1. -->
<BaseLayout title="Signboards in Jhang — site under construction" noindex>
  <section class="mx-auto flex min-h-screen max-w-2xl flex-col justify-center gap-4 px-4 py-16">
    <p class="text-sm tracking-widest text-brand uppercase">Phase 0 preview</p>
    <h1 class="font-display text-4xl font-bold">Signboards in {site.address.city}</h1>
    <p class="text-muted">
      The project scaffold is running. The content site is built in Phase 1.
    </p>
    <p>
      <a class="text-brand underline" href="/spike/rtl/">Urdu / RTL rendering spike →</a>
    </p>
  </section>
</BaseLayout>
