---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/ui/WhatsAppButton.astro';
import { NAV, SECONDARY_NAV } from '../config/nav';
import { waMessageGeneral } from '../lib/whatsapp';

const waMessage = waMessageGeneral(new URL('/', Astro.site).href);
---

<BaseLayout title="Page not found" description="This page does not exist. Use the links to find signage types, the portfolio or contact details." noindex {waMessage}>
  <section class="wrap section">
    <p class="eyebrow text-blue">Error 404</p>
    <h1 class="mt-2 text-4xl font-extrabold">Page not found</h1>
    <p class="mt-4 max-w-xl text-muted">The page you were looking for has moved or does not exist. Try one of these:</p>
    <ul class="mt-6 grid max-w-xl gap-x-8 sm:grid-cols-2">
      {
        [{ href: '/', label: 'Home' }, ...NAV, ...SECONDARY_NAV].map((item) => (
          <li>
            <a href={item.href} class="flex min-h-11 items-center font-semibold underline underline-offset-2">{item.label}</a>
          </li>
        ))
      }
    </ul>
    <WhatsAppButton message={waMessage} location="404" class="mt-8" />
  </section>
</BaseLayout>
