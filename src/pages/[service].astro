---
// Pages for services that are not signs, from src/content/services/.
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import CTABand from '../components/ui/CTABand.astro';
import FAQ from '../components/ui/FAQ.astro';
import Icon from '../components/ui/Icon.astro';
import KitIcon from '../components/ui/KitIcon.astro';
import WhatsAppButton from '../components/ui/WhatsAppButton.astro';
import { formatDate, getServices, getTypes, type Service } from '../lib/content';
import { breadcrumbList, faqPage, otherService } from '../lib/schema';
import { waMessageForService } from '../lib/whatsapp';

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((service) => ({ params: { service: service.id }, props: { service } }));
}

interface Props {
  service: Service;
}
const { service } = Astro.props;
const d = service.data;

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const waMessage = waMessageForService(d.title.toLowerCase(), d.enquiryFields, pageUrl);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: d.title, href: `/${service.id}/` },
];
// Branded kits sit naturally next to a logo sign for the same office.
const reception = (await getTypes()).find((t) => t.id === 'reception-logo-signs');
---

<BaseLayout
  title={d.seo.title ?? d.title}
  description={d.seo.description ?? d.shortDescription}
  schema={[otherService(service, pageUrl, Astro.site!), breadcrumbList(crumbs, Astro.site!), faqPage(d.faqs)]}
  {waMessage}
  waType={service.id}
>
  <section class="bg-hero text-white">
    <div class:list={['wrap grid items-center gap-8 py-10 md:py-14', d.heroImage && 'md:grid-cols-2']}>
      <div>
        <Breadcrumbs items={crumbs} dark />
        <h1 class="mt-4 text-3xl leading-tight font-extrabold md:text-5xl">{d.title}</h1>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-white/85">{d.summary}</p>
        <WhatsAppButton message={waMessage} location="service-hero" type={service.id} class="mt-6" />
        <p class="mt-5 text-sm text-white/70">
          Last updated <time datetime={d.updated.toISOString().slice(0, 10)}>{formatDate(d.updated)}</time>
        </p>
      </div>
      {
        d.heroImage && (
          <Picture
            src={d.heroImage}
            alt={d.heroAlt ?? ''}
            formats={['avif', 'webp']}
            widths={[400, 640, 960, 1280]}
            sizes="(min-width: 768px) 50vw, 100vw"
            loading="eager"
            fetchpriority="high"
            class="aspect-[16/10] w-full rounded-xl object-cover"
          />
        )
      }
    </div>
  </section>

  {
    d.items.length > 0 && (
      <section class="wrap section">
        <p class="eyebrow text-blue">In the box</p>
        <h2 class="h2 mt-2">What goes in the box?</h2>
        <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {d.items.map((item) => (
            <li class="flex gap-4 rounded-xl border border-line bg-white p-5">
              <span class="flex size-14 shrink-0 items-center justify-center rounded-xl bg-blue-soft text-blue">
                <KitIcon name={item.name} class="size-8" />
              </span>
              <div>
                <h3 class="text-lg font-bold">{item.name}</h3>
                <p class="mt-1 text-[0.95rem] leading-relaxed text-muted">{item.text}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    d.bestFor.length > 0 && (
      <section class="bg-paper-soft">
        <div class="wrap section">
          <h2 class="h2">Who are welcome kits for?</h2>
          <ul class="mt-6 grid gap-3 sm:grid-cols-3">
            {d.bestFor.map((item) => (
              <li class="flex gap-3 rounded-xl bg-white p-4">
                <Icon name="check" class="mt-0.5 size-5 shrink-0 text-blue" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    d.steps.length > 0 && (
      <section class="wrap section">
        <h2 class="h2">How does ordering work?</h2>
        <ol class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {d.steps.map((step, i) => (
            <li class="rounded-xl border border-line bg-white p-5">
              <span class="flex size-9 items-center justify-center rounded-full bg-brand font-display font-extrabold text-brand-ink">{i + 1}</span>
              <h3 class="mt-4 text-lg leading-snug font-bold">{step.title}</h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-muted">{step.text}</p>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    d.faqs.length > 0 && (
      <section class="wrap section border-t border-line">
        <h2 class="h2">Questions about {d.title.toLowerCase()}</h2>
        <div class="mt-6">
          <FAQ items={d.faqs} />
        </div>
      </section>
    )
  }

  {
    reception && (
      <section class="bg-paper-soft">
        <div class="wrap section flex flex-col items-start gap-4 md:flex-row md:items-center md:justify-between">
          <div class="max-w-2xl">
            <h2 class="h2">Your logo on the office wall too</h2>
            <p class="mt-3 leading-relaxed text-muted">
              We also make reception and logo wall signs, so new staff are welcomed by the same brand from the
              front door to their desk.
            </p>
          </div>
          <a href={`/signage/${reception.id}/`} class="inline-flex min-h-11 items-center gap-2 font-semibold underline underline-offset-4">
            {reception.data.title} <Icon name="arrow" class="size-4 rtl:rotate-180" />
          </a>
        </div>
      </section>
    )
  }

  <CTABand
    heading={`Order ${d.title.toLowerCase()}`}
    text="Send your logo, the number of kits and the items you want. You get a mock-up and a quote on WhatsApp."
    message={waMessage}
    type={service.id}
    noDesign
  />
</BaseLayout>
