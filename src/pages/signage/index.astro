---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import TypesGrid from '../../components/sections/TypesGrid.astro';
import CTABand from '../../components/ui/CTABand.astro';
import WhatsAppButton from '../../components/ui/WhatsAppButton.astro';
import { getTypes, LIGHTING_LABELS } from '../../lib/content';
import { breadcrumbList } from '../../lib/schema';
import { waMessageGeneral } from '../../lib/whatsapp';

const types = await getTypes();
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Signage', href: '/signage/' },
];
const waMessage = waMessageGeneral(new URL(Astro.url.pathname, Astro.site).href);
const ENV = { indoor: 'Indoor', outdoor: 'Outdoor', both: 'Indoor & outdoor' };
const COST = ['', 'Lower', 'Medium', 'Higher'];
const showCost = types.some((t) => t.data.relativeCost);
---

<BaseLayout
  title="Signboard Types: 3D, LED, Neon & More"
  description="Compare every type of signboard: 3D acrylic letters, LED and neon signs, ACP boards, light boxes, nameplates and indoor signs."
  schema={[breadcrumbList(crumbs, Astro.site!)]}
  {waMessage}
>
  <section class="bg-hero text-white">
    <div class="wrap py-10 md:py-14">
      <Breadcrumbs items={crumbs} dark />
      <h1 class="mt-4 max-w-3xl text-3xl leading-tight font-extrabold md:text-5xl">Types of signboards we make</h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-white/85">
        We make 2D and 3D signboards, LED-lit letters, neon signs and nameplates. Choose a type below to see
        what it is, where it works best and the questions customers ask most, or compare them all in the table.
      </p>
      <WhatsAppButton message={waMessage} location="signage-index" class="mt-6" />
    </div>
  </section>

  {
    types.length === 0 ? (
      <section class="wrap section">
        <p class="max-w-xl text-muted">Signage types are being added. Message us on WhatsApp to ask about any sign.</p>
      </section>
    ) : (
      <>
        <section class="wrap section">
          <h2 class="h2">All signage types</h2>
          <div class="mt-8">
            <TypesGrid {types} headingLevel="h3" />
          </div>
        </section>

        <section class="bg-paper-soft">
          <div class="wrap section">
            <h2 class="h2">Which type of sign should I choose?</h2>
            <p class="mt-3 max-w-2xl leading-relaxed text-muted">
              Every type side by side: what it suits, how it can be lit, and whether it works indoors or outdoors.
            </p>
            <ul class="mt-8 grid gap-4">
              {types.map((t) => (
                <li class="group relative rounded-xl border border-line bg-white p-5 shadow-sm transition-shadow hover:shadow-md md:p-6">
                  <div class="grid gap-4 md:grid-cols-[minmax(0,15rem)_minmax(0,1fr)] md:gap-8">
                    <div>
                      <h3 class="text-lg leading-snug font-bold">
                        <a href={`/signage/${t.id}/`} class="after:absolute after:inset-0 group-hover:underline">
                          {t.data.title}
                        </a>
                      </h3>
                      <p class="mt-1 text-sm leading-relaxed text-muted">{t.data.shortDescription}</p>
                    </div>
                    <dl class:list={['grid gap-x-6 gap-y-4 sm:grid-cols-2', showCost ? 'lg:grid-cols-[1.4fr_1fr_1fr_0.8fr]' : 'lg:grid-cols-[1.4fr_1fr_1fr]']}>
                      <div>
                        <dt class="eyebrow text-blue">Best for</dt>
                        <dd class="mt-1">
                          <ul class="grid gap-1 text-[0.95rem] leading-snug">
                            {t.data.bestFor.map((item) => (
                              <li class="flex gap-2">
                                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true" />
                                {item}
                              </li>
                            ))}
                          </ul>
                        </dd>
                      </div>
                      <div>
                        <dt class="eyebrow text-blue">Lighting</dt>
                        <dd class="mt-1 flex flex-wrap gap-1.5">
                          {t.data.lightingOptions.map((l) => (
                            <span class="rounded-full bg-blue-soft px-2.5 py-0.5 text-sm font-medium text-blue">{LIGHTING_LABELS[l]}</span>
                          ))}
                        </dd>
                      </div>
                      <div>
                        <dt class="eyebrow text-blue">Where</dt>
                        <dd class="mt-1 text-[0.95rem]">{ENV[t.data.environment]}</dd>
                      </div>
                      {showCost && (
                        <div>
                          <dt class="eyebrow text-blue">Cost</dt>
                          <dd class="mt-1 flex items-center gap-2 text-[0.95rem]">
                            <span class="flex gap-1" aria-hidden="true">
                              {[1, 2, 3].map((n) => (
                                <span class:list={['block h-2 w-5 rounded-full', n <= (t.data.relativeCost ?? 0) ? 'bg-brand' : 'bg-line']} />
                              ))}
                            </span>
                            {COST[t.data.relativeCost ?? 0]}
                          </dd>
                        </div>
                      )}
                    </dl>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </section>
      </>
    )
  }

  <CTABand message={waMessage} />
</BaseLayout>
